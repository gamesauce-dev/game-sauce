{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "game-sauce",
  "version": "0.5.5",
  "identifier": "dev.gamesauce.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../server-stage/server/runtime/": "runtime/",
      "../server-stage/server/app/": "app/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
