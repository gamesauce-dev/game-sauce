{
  "name": "game-sauce",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "Self-hosted ROM manager: ingest, catalog, metadata, download",
  "scripts": {
    "start": "node src/server.js",
    "docker:build": "docker build -t game-sauce:latest .",
    "docker:up": "docker compose up -d --build",
    "docker:logs": "docker compose logs -f game-sauce",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^4.21.2",
    "jpeg-js": "^0.4.4",
    "multer": "^2.5.0",
    "pngjs": "^7.0.0",
    "saxen": "^11.2.0"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
