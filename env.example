# game-sauce — copy to `.env` and edit:  cp env.example .env
# docker compose reads `.env` automatically (see env_file in docker-compose.yml).
# Anything set here wins over values typed into the UI.

# First admin created on first boot (min 10 chars, letter + number).
# If the database already has a user, these two are ignored.
GAMESAUCE_ADMIN_USER=admin
GAMESAUCE_ADMIN_PASSWORD=change-me-please-1

# Encrypts stored provider credentials (ScreenScraper / TheGamesDB).
# Generate one with:  openssl rand -base64 32
# If unset, a key file is auto-created at /app/data/secret.key instead.
GAMESAUCE_SECRET_KEY=

# Shared ScreenScraper dev pair (OPTIONAL, distributor use).
# Fills the Developer ID/password for everyone so the app works out of the box
# at a shared, slower quota. Any user who types their own dev pair in the UI
# automatically uses theirs instead — per-user values always win.
# Get a free pair with a request on the ScreenScraper forum, then paste it here:
# SS_DEV_ID_SHARED=
# SS_DEV_PASSWORD_SHARED=

# Network
HOST=0.0.0.0
PORT=8080

# Only needed behind a reverse proxy that terminates TLS:
# GAMESAUCE_COOKIE_SECURE=1
# GAMESAUCE_TRUST_PROXY=1

# --- Optional extra metadata providers -------------------------------------
# IGDB (Twitch, free for non-commercial use): create a Twitch developer app to
# get a Client ID + Client Secret (minutes, no approval wait). Best catalogue
# for modern systems (PS4/PS5, Switch, Xbox One/Series).
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# SteamGridDB (art fallback only): free key from your SteamGridDB profile
# (sign in with Steam → Preferences → API). Used only for covers when a
# metadata match has no art of its own.
# SGDB_API_KEY=
